# ==============================================================================
# EJEMPLO CONFIGURACIÓN DE ENTORNO - APP-GZR
# ==============================================================================

# Entorno activo: 'local' (usa LogLocalEnviadorCorreo) | 'production' (usa SMTP real)
APP_ENV=production
APP_URL=https://tudominio.com

# Orígenes CORS adicionales permitidos separados por coma (opcional en producción)
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://tudominio.com

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_base_datos
DB_USER=usuario_mysql
DB_PASS=contrasena_segura
DB_CHARSET=utf8mb4

# ==============================================================================
# Configuración SMTP para envío de correos en Producción (Prioridad 3)
# ==============================================================================
SMTP_HOST=tudominio.com
SMTP_PORT=587  #(STARTTLS)
#SMTP_PORT=465 #(SMTP_ENCRYPTION=ssl) si 587 esta bloqueada
SMTP_ENCRYPTION=tls
SMTP_USER=tu_correo@gmail.com
# no debes poner tu contraseña normal de Gmail, 
# sino una Contraseña de Aplicación de 16 caracteres 
# generada desde la configuración de seguridad de tu 
#cuenta de Google (requiere tener activa la verificación en dos pasos).
SMTP_PASS=clave_smtp
SMTP_FROM_EMAIL=no-reply@tudominio.com
SMTP_FROM_NAME="Peligro Estructural Inminente"

# ==============================================================================
# Geocerca autorizada (Centro: Pereira, Risaralda | Radio: 40 km)
# ==============================================================================
# Modo de geocerca: 'circular' (Pereira/región)
# Modo de geocerca: 'nacional' (Todo Colombia)
GEO_MODO=nacional
#GEO_MODO=circular
GEO_CENTRO_LAT=4.8133
GEO_CENTRO_LNG=-75.6961
GEO_RADIO_KM=40
